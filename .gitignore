/target
/.toolchain
*.log
user/linuxtest/tcore/

# Generated output: serial logs, LLVM IR, build captures. Every run writes
# logs/<suite>/serial.log; the scratch disk image stays in TEMP because it is
# tens of MB and disposable. Nothing here is source.
/logs/

# Build/debug artifacts (M10b repo hygiene). These are regenerated by build.ps1
# and were previously committed; none are source. The *.txt glob is safe here
# because every tracked .txt in this repo is a build log (verified), and the
# real documentation lives in docs/*.md.
*.ll
*.err
*.out
*.pid
*.txt

# Per-crate build artifacts. The root /target rule above only covers the workspace
# target dir; test_asm has its own target/ that was previously tracked (with an
# absolute path baked into the .d files, which broke after the folder rename).
test_asm/target/

